/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://opps-widget.getwarmly.com https://client.crisp.chat; style-src 'self' 'unsafe-inline' https://client.crisp.chat; font-src 'self' https://client.crisp.chat; img-src 'self' data: https://*.getwarmly.com https://image.crisp.chat https://client.crisp.chat; media-src https://client.crisp.chat; connect-src 'self' https://*.getwarmly.com https://client.crisp.chat https://storage.crisp.chat wss://client.relay.crisp.chat; frame-src https://*.getwarmly.com https://game.crisp.chat; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  Cross-Origin-Opener-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none

# Fonts are self-hosted via next/font (no more Google Fonts CDN), so
# style-src/font-src no longer need external hosts. next/font emits its font
# files under /_next/static/media with a content hash in the filename, so they
# are covered by the /_next/* immutable rule below rather than needing their
# own block here.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Safe only because these filenames carry a content hash (mocks, logos, icons).
# immutable tells the browser not to revalidate for a year, so on an unhashed
# name it guarantees that returning visitors get new HTML against an old asset.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The three exceptions keep fixed names, so they cannot make the same promise.
# A day is long enough to be cheap and short enough to correct a mistake.
/assets/og.png
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=86400

/assets/icons/favicon.ico
  Cache-Control: public, max-age=86400

/llms.txt
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
